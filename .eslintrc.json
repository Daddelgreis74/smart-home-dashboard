{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-empty": "warn"
  },
  "overrides": [
    {
      "files": ["public/**/*.js"],
      "env": {
        "browser": true,
        "node": false
      },
      "globals": {
        "io": "readonly",
        "Sortable": "readonly",
        "applyTranslations": "writable",
        "translations": "readonly"
      },
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["tests/**/*.test.js", "tests/**/*.spec.js"],
      "env": {
        "jest": true
      }
    }
  ]
}
